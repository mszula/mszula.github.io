---
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" class="section">
  <div class="container">
    <header class="phead reveal">
      <span class="pixel-label"><span class="star">✦</span> projects</span>
      <h2 class="section-title">Stuff I've built</h2>
      <p class="lede">
        A few things I made because I wanted them to exist. Most are open source
        — go ahead and poke around.
      </p>
    </header>

    <!-- Featured projects with screenshots -->
    <div class="featured">
      {
        featured.map((p, i) => (
          <article
            class="feat reveal"
            style={`--card-accent: var(${p.accent}); --reveal-delay: ${i * 90}ms`}
          >
            <a
              class="feat__media"
              href={p.demo?.href ?? p.repo}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
            >
              <img src={p.image!.src} alt={p.image!.alt} loading="lazy" />
            </a>
            <div class="feat__body">
              <h3 class="feat__name">{p.name}</h3>
              <p class="feat__blurb">{p.blurb}</p>
              <ul class="tags">
                {p.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              <div class="feat__links">
                {p.demo && (
                  <a
                    class="btn btn--primary btn--sm"
                    href={p.demo.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    ▶ {p.demo.label}
                  </a>
                )}
                <a
                  class="btn btn--sm"
                  href={p.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Code ↗
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Smaller projects -->
    <div class="mini-grid">
      {
        rest.map((p, i) => (
          <a
            class="mini reveal"
            style={`--card-accent: var(${p.accent}); --reveal-delay: ${i * 70}ms`}
            href={p.repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="mini__cover">
              <span class="mini__glyph">{p.glyph}</span>
            </div>
            <h3 class="mini__name">{p.name}</h3>
            <p class="mini__blurb">{p.blurb}</p>
            <ul class="tags">
              {p.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
            <span class="mini__link">Code ↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .phead {
    margin-bottom: 2.5rem;
  }
  .phead .section-title {
    margin-bottom: 0.9rem;
  }

  /* ---- Featured ------------------------------------------------------- */
  .featured {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 1.75rem;
  }
  .feat {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 0;
    background: var(--paper-2);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .feat:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 9px 0 var(--ink);
  }
  /* alternate image side for rhythm */
  .feat:nth-child(even) .feat__media {
    order: 2;
    border-left: var(--border);
    border-right: 0;
  }

  .feat__media {
    display: block;
    padding: 1.4rem;
    background: color-mix(in srgb, var(--card-accent) 22%, var(--paper-2));
    border-right: var(--border);
    display: grid;
    place-items: center;
  }
  .feat__media img {
    width: 100%;
    border: var(--border);
    border-radius: 8px;
    box-shadow: 3px 3px 0 var(--ink);
  }

  .feat__body {
    padding: 1.7rem 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .feat__name {
    font-family: var(--font-pixel);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }
  .feat__blurb {
    font-size: 1rem;
    color: var(--ink-soft);
    flex: 1;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .feat:hover .tag,
  .mini:hover .tag {
    border-color: var(--card-accent);
  }
  .feat__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.3rem;
  }
  .feat__links .btn--primary {
    background: var(--card-accent);
  }

  /* ---- Mini grid ------------------------------------------------------ */
  .mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .mini {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--paper-2);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.1rem 1.2rem 1.3rem;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .mini:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .mini:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }
  .mini__cover {
    width: 100%;
    aspect-ratio: 16 / 7;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--card-accent) 26%, var(--paper-2));
    border: var(--border);
    border-radius: 9px;
    margin-bottom: 1rem;
  }
  .mini__glyph {
    font-size: 2.2rem;
    filter: saturate(1.1);
  }
  .mini__name {
    font-family: var(--font-pixel);
    font-size: 0.78rem;
    line-height: 1.4;
    margin-bottom: 0.6rem;
  }
  .mini__blurb {
    font-size: 0.9rem;
    color: var(--ink-soft);
    flex: 1;
  }
  .mini .tags {
    margin-top: 0.9rem;
  }
  .mini__link {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .mini:hover .mini__link {
    color: var(--card-accent);
  }

  @media (max-width: 820px) {
    .feat {
      grid-template-columns: 1fr;
    }
    .feat:nth-child(even) .feat__media {
      order: 0;
      border-left: 0;
    }
    .feat__media {
      border-right: 0;
      border-bottom: var(--border);
    }
    .mini-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
