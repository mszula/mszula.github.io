};

const body = icons[name] ?? '';
const dims = typeof size === 'number' ? `${size}` : size;
---

<svg
  width={dims}
  height={dims}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
  set:html={body}
/>
